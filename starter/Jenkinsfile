pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        APP_NAME = 'starter-backend'
        IMAGE_NAME = 'starter-backend'
        IMAGE_TAG = "${BUILD_NUMBER}"
        DB_URL = 'jdbc:postgresql://host.docker.internal:5444/spring-boot'
        DB_USER = 'nyusss'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Java') {
            steps {
                sh '''
                    java -version
                    ./mvnw -version
                    docker version
                '''
            }
        }

        stage('Build and Test') {
            steps {
                sh '''
                    chmod +x mvnw
                    ./mvnw -B clean verify
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                      -t ${IMAGE_NAME}:${IMAGE_TAG} \
                      -t ${IMAGE_NAME}:latest .
                '''
            }
        }

        stage('Database Migration') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'starter-db-credentials',
                        usernameVariable: 'MIGRATION_DB_USER',
                        passwordVariable: 'MIGRATION_DB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x

                        ./mvnw -B \
                          -Dflyway.url="${DB_URL}" \
                          -Dflyway.user="${MIGRATION_DB_USER}" \
                          -Dflyway.password="${MIGRATION_DB_PASSWORD}" \
                          flyway:info

                        ./mvnw -B \
                          -Dflyway.url="${DB_URL}" \
                          -Dflyway.user="${MIGRATION_DB_USER}" \
                          -Dflyway.password="${MIGRATION_DB_PASSWORD}" \
                          flyway:migrate
                    '''
                }
            }
        }

        stage('Deploy Backend') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'starter-db-credentials',
                        usernameVariable: 'RUNTIME_DB_USER',
                        passwordVariable: 'RUNTIME_DB_PASSWORD'
                    )
                ]) {
                    sh '''
                        docker rm -f ${APP_NAME} || true

                        docker run -d \
                        --name ${APP_NAME} \
                        --restart unless-stopped \
                        -p 8080:8080 \
                        -e SPRING_DATASOURCE_URL="${DB_URL}" \
                        -e SPRING_DATASOURCE_USERNAME="${RUNTIME_DB_USER}" \
                        -e SPRING_DATASOURCE_PASSWORD="${RUNTIME_DB_PASSWORD}" \
                        -e SPRING_FLYWAY_ENABLED=false \
                        ${IMAGE_NAME}:${IMAGE_TAG}
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    for i in $(seq 1 30); do
                      if curl -fsS http://localhost:8080/actuator/health; then
                        echo "Health check berhasil"
                        exit 0
                      fi

                      sleep 2
                    done

                    echo "Health check gagal"
                    docker logs ${APP_NAME}
                    exit 1
                '''
            }
        }
    }

    post {
        success {
            echo 'CI/CD berhasil: build, migration, dan deployment selesai.'
        }

        failure {
            echo 'Pipeline gagal. Periksa stage yang gagal dan log Jenkins.'
        }

        always {
            echo 'Pipeline selesai.'
        }
    }
}