
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        PROJECT_DIR = 'starter'
        MAVEN_IMAGE = 'eclipse-temurin:25-jdk'
        JENKINS_CONTAINER = 'jenkins-local'
        APP_NAME = 'starter-backend'
        IMAGE_NAME = 'starter-backend'
        IMAGE_TAG = "${BUILD_NUMBER}"

        DB_URL = 'jdbc:postgresql://host.docker.internal:5444/spring-boot'
        DB_CREDENTIALS_ID = 'starter-db-credentials'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm

                sh '''
                    test -f starter/pom.xml
                    test -f starter/Dockerfile
                    test -f starter/mvnw
                    test -f starter/Jenkinsfile
                '''
            }
        }

        stage('Check Environment') {
            steps {
                sh '''
                    docker version
                    curl --version
                    docker pull ${MAVEN_IMAGE}
                '''
            }
        }

        stage('Unit Test & Coverage') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        chmod +x mvnw
                        docker run --rm \
                          --volumes-from ${JENKINS_CONTAINER} \
                          -v starter-m2-cache:/root/.m2 \
                          -w "$PWD" \
                          ${MAVEN_IMAGE} \
                          sh -c '
                            ./mvnw -B clean test
                            TEST_STATUS=$?

                            ./mvnw -B jacoco:report
                            REPORT_STATUS=$?

                            if [ "$TEST_STATUS" -ne 0 ]; then
                              exit "$TEST_STATUS"
                            fi

                            exit "$REPORT_STATUS"
                          '
                    '''
                }
            }

            post {
                always {
                    junit(
                        testResults: "${PROJECT_DIR}/target/surefire-reports/TEST-*.xml",
                        allowEmptyResults: true
                    )

                    recordCoverage(
                        tools: [[
                            parser: 'JACOCO',
                            pattern: "${PROJECT_DIR}/target/site/jacoco/jacoco.xml"
                        ]]
                    )
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        docker build \
                          -t ${IMAGE_NAME}:${IMAGE_TAG} \
                          .
                    '''
                }
            }
        }

        stage('Database Migration') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'starter-db-credentials',
                        usernameVariable: 'MIGRATION_DB_USER',
                        passwordVariable: 'MIGRATION_DB_PASSWORD'
                    )
                ]) {
                    dir("${PROJECT_DIR}") {
                        sh '''
                            set +x

                            docker run --rm \
                              --volumes-from ${JENKINS_CONTAINER} \
                              -v starter-m2-cache:/root/.m2 \
                              -w "$PWD" \
                              -e DB_URL -e MIGRATION_DB_USER -e MIGRATION_DB_PASSWORD \
                              ${MAVEN_IMAGE} \
                              sh -c './mvnw -B \
                                -Dliquibase.url="$DB_URL" \
                                -Dliquibase.username="$MIGRATION_DB_USER" \
                                -Dliquibase.password="$MIGRATION_DB_PASSWORD" \
                                liquibase:status liquibase:update'
                        '''
                    }
                }
            }
        }

        stage('Deploy Backend') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'starter-db-credentials',
                        usernameVariable: 'RUNTIME_DB_USER',
                        passwordVariable: 'RUNTIME_DB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x

                        docker rm -f ${APP_NAME} || true

                        docker run -d \
                          --name ${APP_NAME} \
                          --restart unless-stopped \
                          -p 8080:8080 \
                          -e SPRING_DATASOURCE_URL="${DB_URL}" \
                          -e SPRING_DATASOURCE_USERNAME="${RUNTIME_DB_USER}" \
                          -e SPRING_DATASOURCE_PASSWORD="${RUNTIME_DB_PASSWORD}" \
                          -e SPRING_LIQUIBASE_ENABLED=false \
                          ${IMAGE_NAME}:${IMAGE_TAG}
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    for i in $(seq 1 30); do
                        if curl -fsS \
                          http://host.docker.internal:8080/health; then
                            echo "Health check berhasil"
                            exit 0
                        fi

                        sleep 2
                    done

                    echo "Health check gagal"
                    docker logs ${APP_NAME}
                    exit 1
                '''
            }
        }
    }

    post {
        success {
            echo 'CI/CD berhasil: build, migration, deployment, dan health check selesai.'
        }

        failure {
            echo 'Pipeline gagal. Periksa Console Output untuk menemukan stage yang gagal.'
        }

        always {
            echo 'Pipeline selesai.'
        }
    }
}
